{erl_opts, [debug_info, warnings_as_errors]}.

%% etx depends on the applications redwall and peace. For local
%% development, link checkouts at `_checkouts/redwall' and
%% `_checkouts/peace'. rebar3 uses a checkout in the place of a dependency
%% with the same name.
{deps, [
    {redwall, {git, "https://github.com/jessestimpson/redwall.git", {branch, "main"}}},
    {peace, {git, "https://github.com/jessestimpson/peace.git", {branch, "main"}}}
]}.

{shell, [
    {apps, [etx]}
]}.

{profiles, [
    %% Deterministic simulation testing. Run it with `dst/run.sh'.
    %% Everything related to eta is confined to this profile:
    %%   - the DST define, which enables include/etx_eta.hrl,
    %%   - the eta dependency, and
    %%   - dst/, which contains the harness and its test suite.
    %% redwall and peace are compiled with DST too, so that every process
    %% of a cluster runs under the scheduler of eta.
    %% For local development, link a checkout of eta at `_checkouts/eta'.
    {dst, [
        % rebar.lock holds the dependencies of the default profile only, so
        % the version of eta is fixed here, with a commit.
        {deps, [
            {eta,
                {git, "https://github.com/jessestimpson/eta.git",
                    {ref, "d4323f1527952b9960020a0c06947d18a312cb3c"}}}
        ]},
        {erl_opts, [{d, 'DST'}]},
        {overrides, [
            {add, redwall, [{erl_opts, [{d, 'DST'}]}]},
            {add, peace, [{erl_opts, [{d, 'DST'}]}]}
        ]},
        {extra_src_dirs, ["dst"]},
        {eunit_tests, [{module, etx_dst_tests}]},
        {eunit_opts, [verbose]}
    ]}
]}.
